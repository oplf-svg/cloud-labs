{
  "extends": "../core/tsconfig.json",
  "compilerOptions": {
    "noEmit": false, "outDir": "./out", "allowImportingTsExtensions": false, "rewriteRelativeImportExtensions": true, "verbatimModuleSyntax": false,
    "isolatedModules": true, "experimentalDecorators": true, "importHelpers": true, "types": [],
    "paths": { "@recorder/core": ["../core/src/index.ts"] }
  },
  "angularCompilerOptions": { "strictTemplates": true, "strictInjectionParameters": true, "strictInputAccessModifiers": true },
  "files": ["src/main.ts"],
  "include": ["src/**/*.ts"]
}
